class Solution {
public:
    int firstUniqueEven(std::vector<int>& nums) {
        std::unordered_map<int, int> counts;
        for (int n : nums) {
            counts[n]++;
        }
        for (int n : nums) {
            if (n % 2 == 0 && counts[n] == 1) {
                return n;
            }
        }
        return -1;
    }
};©leetcode
