class Solution {
public:

    int solveRec(vector<int> &prices, int i, int buy, int k)
    {
        if(i==prices.size()  ||  k==0) return 0;

        int profit = 0;
        if(buy)
        {
            int buyStock = -prices[i] + solveRec(prices,i+1,0,k);
            int skip = 0 + solveRec(prices,i+1,1,k);

            profit = max(buyStock,skip);
        }

        else
        {
            int sellStock = prices[i] + solveRec(prices,i+1,1,k-1);
            int skip = 0 + solveRec(prices,i+1,0,k);

            profit = max(sellStock,skip);
        }

        return profit;

    }

    int solveMem(vector<int> &prices, int i, int buy, int k, vector<vector<vector<int>>> &dp)
    {
        if(i==prices.size()  ||  k==0) return 0;

        if(dp[i][buy][k]!=-1) return dp[i][buy][k];

        int profit = 0;

        if(buy)
        {
            int buyStock = -prices[i] + solveMem(prices,i+1,0,k,dp);
            int skip = 0 + solveMem(prices,i+1,1,k,dp);

            profit = max(buyStock, skip);
        }

        else
        {
            int sellStock = prices[i] + solveMem(prices,i+1,1,k-1,dp);
            int skip = 0 + solveMem(prices,i+1,0,k,dp);

            profit = max(sellStock,skip);
        }

        return dp[i][buy][k] = profit;
    }

    int solveTab(vector<int> &prices, int k)
    {
        int n = prices.size();

        vector<vector<vector<int>>>dp(n+1, vector<vector<int>>(2,vector<int>(k+1,0)));

        for(int i=n-1;i>=0;i--)
        {
            for(int buy=0;buy<=1;buy++)
            {
                for(int cnt = k;cnt>0;cnt--)
                {
                    int profit = 0;

                    if(buy)
                    {
                        int buyStock = -prices[i] + dp[i+1][0][cnt];
                        int skip = 0 + dp[i+1][1][cnt];

                        profit = max(buyStock,skip);
                    }

                    else
                    {
                        int sellStock = prices[i] + dp[i+1][1][cnt-1];
                        int skip = 0 + dp[i+1][0][cnt];

                        profit = max(sellStock,skip);
                    }

                    dp[i][buy][cnt] = profit;
                }
            }
        }

        return dp[0][1][k];
    }

    int solveSO(vector<int> &prices, int k)
    {
        int n = prices.size();

        vector<vector<int>>curr(2,vector<int>(k+1,0));
        vector<vector<int>>nxt(2,vector<int>(k+1,0));

        for(int i=n-1;i>=0;i--)
        {
            for(int buy=0;buy<=1;buy++)
            {
                for(int cnt=k;cnt>0;cnt--)
                {
                    int profit = 0;

                    if(buy)
                    {
                        int buyStock = -prices[i] + nxt[0][cnt];
                        int skip = 0 + nxt[1][cnt];

                        profit = max(buyStock,skip);
                    }

                    else
                    {
                        int sellStock = prices[i] + nxt[1][cnt-1];
                        int skip = 0 + nxt[0][cnt];

                        profit = max(sellStock,skip);
                    }

                    curr[buy][cnt]= profit;
                }
            }

            nxt = curr;
        }

        return nxt[1][k];
    }

    int maxProfit(int k, vector<int>& prices) {
        
        int n = prices.size();
        int ans = 0;
        if(n<=k)
        {
            for(int i=1;i<n;i++) if(prices[i]>prices[i-1]) ans+=(prices[i]-prices[i-1]);
            return ans;
        }


        //return solveRec(prices,0,1,k);
        vector<vector<vector<int>>>dp(n,vector<vector<int>>(2,vector<int>(k+1,-1)));

        //return solveMem(prices,0,1,k,dp);
        //return solveTab(prices,k);

        return solveSO(prices,k);
    }
};
